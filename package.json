{
  "name": "agentx-go-developer-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:prepare": "go run ./scripts/prepare_docs_portal.go",
    "docs:dev": "npm run docs:prepare && vitepress dev portal",
    "docs:build": "npm run docs:prepare && vitepress build portal",
    "docs:preview": "vitepress preview portal",
    "docs:check": "npm run docs:build && go run ./scripts/check_docs_portal.go",
    "docs:audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
